# ── Agent Identity ───────────────────────────────────────────────────────────
AGENT_ID=agent_1
P2P_PORT=4001
DATA_DIR=./data

# ── Bootstrap Peers (comma-separated multiaddrs) ──────────────────────────────
BOOTSTRAP_PEERS=/ip4/127.0.0.1/tcp/4001/p2p/QmBootstrapPeerID1

# ── Ethereum ─────────────────────────────────────────────────────────────────
ETH_ENABLED=true
ETH_RPC_URL=https://ethereum.publicnode.com
ETH_WS_URL=wss://ethereum.publicnode.com
ETH_CHAIN_ID=1
ETH_POLL_INTERVAL=12

# ── Sui ──────────────────────────────────────────────────────────────────────
SUI_ENABLED=true
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
SUI_POLL_INTERVAL=3

# ── Solana ───────────────────────────────────────────────────────────────────
SOL_ENABLED=true
SOL_RPC_URL=https://api.mainnet-beta.solana.com
SOL_WS_URL=wss://api.mainnet-beta.solana.com
SOL_POLL_INTERVAL=1

# ── Consensus ────────────────────────────────────────────────────────────────
MIN_CONSENSUS_PEERS=2
CONSENSUS_THRESHOLD=0.67

# ── Blockchain Anchoring (optional) ──────────────────────────────────────────
ANCHOR_ENABLED=false
ANCHOR_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
ANCHOR_PACKAGE_ID=
ANCHOR_KEYPAIR_PATH=./data/sui_keypair.json

# ── Monitoring ───────────────────────────────────────────────────────────────
DASHBOARD_PORT=8080
METRICS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json
